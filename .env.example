# Turning Pages backend — environment variables
# Copy to .env and fill in. Every variable listed here is read by the app; the app refuses to start
# if a required one is missing. Lines marked (optional) show the default used when unset.

# --- App ---
APP_NAME=Turning Pages
NODE_ENV=production                 # production | development | test
PORT=5000                           # (optional)
DEFAULT_TIMEZONE=UTC                # (optional) IANA zone, e.g. Asia/Kolkata
TRUST_PROXY=0                       # (optional) number of reverse proxies in front of the app; 1 behind nginx
ACCESSDOMAINS=https://app.example.com,https://admin.example.com   # allowed CORS origins, comma separated
STORAGE_PATH=/var/www/storage       # (optional) absolute path for uploaded files; defaults to ../storage
DEFAULT_API_DATA_LIMIT=15           # (optional) default page size for role/department lists
SQL_LOGGING=false                   # (optional) log every SQL query; local debugging only

# --- Database (MySQL) ---
CENTRAL_MYSQL_HOST=
CENTRAL_MYSQL_PORT=3306             # (optional)
CENTRAL_MYSQL_USER=
CENTRAL_MYSQL_PASSWORD=
CENTRAL_MYSQL_DB=

# --- Auth ---
JWT_SECRET=                         # at least 32 characters, e.g. output of: openssl rand -hex 32
JWT_ACCESS_EXPIRATION_DAYS=30       # user session length in days
ADMIN_JWT_EXPIRATION=5d             # (optional) admin session length, e.g. 12h or 5d
OTP_LENGTH=6                        # (optional) digits in email codes
OTP_EXPIRATION_MINUTES=10           # (optional)
OTP_MAX_ATTEMPTS=5                  # (optional) wrong guesses before a code is invalidated
OTP_RESEND_COOLDOWN_SECONDS=60      # (optional)
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=15   # (optional)
AUTH_RATE_LIMIT_MAX=20              # (optional) failed auth attempts per IP per 15 minutes

# --- Roles (IDs from the roles table) ---
SUP_ADM_ROLE_ID=1
USR_ROLE_ID=6
SENIOR_EDITOR_ROLE_ID=7
ASSISTANT_EDITOR_ROLE_ID=8

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                   # (optional) true for port 465 (implicit TLS); false uses STARTTLS
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Turning Pages <no-reply@example.com>
ADMIN_NOTIFICATION_EMAIL=           # receives new-signup notifications
SUPPORT_EMAIL=                      # support address shown in emails to users

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_INTENT_CHARGE=
STRIPE_PRICE_STARTER=               # price_... (use test-mode price IDs on staging)
STRIPE_PRICE_AUTHOR=
STRIPE_PRICE_PRO_AUTHOR=
STRIPE_PRICE_STUDIO=

# --- AI providers ---
OPENAI_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
GOWINSTON_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini              # writing assistant chat
GEMINI_TEXT_MODEL=gemini-3.8-flash          # chapter generation, TAV analysis
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1   # book covers
GEMINI_IMAGE_SIZE=1K                        # (optional) 1K | 2K | 4K; larger covers cost more
GEMINI_FACT_CHECK_MODEL=gemini-3.8-flash    # fact-check with Google Search grounding
GROK_MODEL=grok-3-mini                      # fact-check claims, consistency check, summaries

# --- Firebase (Firestore chat) ---
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=               # keep the \n escapes, wrapped in double quotes
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=

# --- One-off script: npm run auth (creates the first super admin; password is emailed) ---
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
ADM_DEPT_ID=2
